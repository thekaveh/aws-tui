$error: $danger;

/* Shared help overlay surface */
HelpModal > #help-frame {
    color: $text;
    background: $bg-elev;
    border: round $accent;
}
HelpModal #help-title,
HelpModal .help-section {
    color: $accent;
}
HelpModal #help-subtitle,
HelpModal .help-dim,
HelpModal #help-footer {
    color: $text-muted;
}

/* Shared service context picker borders */
ContextPicker {
    border: solid $rule-dim;
}
ContextPicker:focus,
ContextPicker:focus-within,
ContextPicker.-open,
ServiceSourceHeader:focus > ContextPicker {
    border: heavy $accent;
}
ContextPicker.-disabled,
ContextPicker.-loading {
    border: solid $rule-dim;
}
ContextPicker.-warning,
ContextPicker.-warning:focus-within {
    border: solid $warning;
}
ContextPicker.-error,
ContextPicker.-error:focus-within {
    border: solid $error;
}

/* The EMR application picker sits beside the source ContextPicker in the EMR
   context row and is a peer cell, so it carries the same border treatment. */
ApplicationPicker {
    border: solid $rule-dim;
}
ApplicationPicker:focus,
ApplicationPicker:focus-within,
ApplicationPicker.-open {
    border: heavy $accent;
}

GluePage GlueIcebergView,
AthenaPage TextArea,
AthenaPage #athena-query-controls,
AthenaPage #athena-query-detail,
AthenaPage #athena-results-summary,
AthenaPage DataTable {
    background: $bg;
    color: $text;
    border: solid $rule-dim;
    border-title-color: $text;
}
GluePage GlueIcebergView:focus-within,
AthenaPage TextArea:focus,
AthenaPage #athena-query-controls:focus-within,
AthenaPage #athena-query-detail:focus-within,
AthenaPage #athena-results-summary:focus-within,
AthenaPage DataTable:focus {
    border: solid $accent;
    border-title-color: $accent;
}

/* The short query controls track still fits its three-row buttons when
   its enclosing decorative border is removed. */
AthenaPage AthenaQueryView.-compact > #athena-query-controls,
AthenaPage AthenaQueryView.-compact > #athena-query-controls:focus-within {
    border: none;
}

AthenaPage #athena-query-status:focus {
    background: $bg-sel;
    color: $accent;
    text-style: bold;
}

/* Shared service-local segmented tab frame */
ServiceTabStrip {
    background: $bg;
    color: $text-muted;
    border: solid $rule-dim;
}
ServiceTabStrip > .service-tab {
    color: $text-muted;
}
ServiceTabStrip > .service-tab.-divided {
    border-left: solid $rule-dim;
}
ServiceTabStrip > .service-tab.-active {
    color: $accent;
    text-style: bold;
}
ServiceTabStrip:focus > .service-tab.-active {
    background: $bg-sel;
    color: $text;
}

/* Transfer history and explicit recovery endpoint review. */
TransferHistoryModal, RetryConflictModal { background: $bg 60%; }
TransferHistoryModal > Vertical, RetryConflictModal > Vertical {
    background: $bg-elev; color: $text; border: round $rule-dim;
}
TransferHistoryModal OptionList, TransferHistoryModal TextArea, RetryConflictModal TextArea {
    background: $bg; color: $text; border: solid $rule-dim;
}
TransferHistoryModal OptionList:focus, TransferHistoryModal TextArea:focus,
RetryConflictModal TextArea:focus { border: solid $accent; }
TransferHistoryModal .modal-footer > ModalButton {
    width: 1fr; min-width: 9; margin: 0; padding: 0 1;
}
RetryConflictModal .modal-footer > ModalButton {
    width: 1fr; min-width: 10; margin: 0; padding: 0 1;
}
RetryConflictModal .modal-footer > ModalButton.-primary { min-width: 20; }
RetryConflictModal .modal-footer > ModalButton.-danger { min-width: 13; }
